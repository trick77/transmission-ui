# transmission-ui production stack (compose.yaml). Copy to .env and fill in.

# Public hostname Traefik routes to the UI. Also whitelisted in the daemon's RPC host
# check; without that the daemon answers 421 to every request that arrives via Traefik.
TM_HOST=transmission.example.com

# RPC basic auth for the daemon; the browser asks for these once. Same creds on the
# Traefik path and on the direct :9091 path.
TM_USER=transmission
TM_PASS=change-me

# Host paths. Subfolders under TM_DOWNLOADS (buffer, radarr, sonarr, …) show up as sidebar folders.
TM_DOWNLOADS=/mnt/data/torrents
TM_WATCH=/mnt/data/torrents/watch

# Peer port published on the host (must match peer-port in settings.json / Settings › Network).
TM_PEER_PORT=51413

# Container user/group and timezone.
PUID=1000
PGID=1000
TZ=Europe/Zurich
