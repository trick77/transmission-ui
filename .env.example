# transmission-ui production stack (compose.yaml). Copy to .env and fill in.

# Public hostname Traefik routes to the UI (Host() rule in compose.yaml).
TM_HOST=transmission.example.com

# Externally reachable base URL. Informational: the redirect and logout URLs
# below are configured directly rather than derived from it.
BACKEND_PUBLIC_URL=https://transmission.example.com

# Signs the session cookie. Generate with: openssl rand -base64 48
# Rotating it invalidates every outstanding session.
BACKEND_SESSION_SECRET=

# --- Authentication ---------------------------------------------------------
# One of:
#   oidc  an identity provider signs users in (the OIDC block below)
#   form  a login page checked against the daemon's TM_USER / TM_PASS, for
#         deployments with no identity provider
#   dev   signs every visitor in automatically; local work only, never on a
#         reachable host
#
# form and oidc both assume a TLS-terminating reverse proxy in front (see
# compose.yaml) -- in form mode a password crosses the wire.
BACKEND_AUTH_MODE=oidc

# OIDC block, required when BACKEND_AUTH_MODE=oidc, ignored otherwise. The client must be
# registered with your IdP as a confidential client (authorization_code).
BACKEND_OIDC_ISSUER=https://auth.example.com
BACKEND_OIDC_CLIENT_ID=transmission-ui
BACKEND_OIDC_CLIENT_SECRET=
BACKEND_OIDC_REDIRECT_URL=https://transmission.example.com/api/auth/callback
# Optional: where the IdP sends the browser after logout (default "").
BACKEND_OIDC_POST_LOGOUT_REDIRECT_URL=https://transmission.example.com/
# Optional: only members of this group may sign in. Empty = every
# authenticated user gets in. Needs the "groups" scope on the client.
# Ignored in form mode, where the credential check is the whole decision.
BACKEND_OIDC_ALLOWED_GROUP=

# --- The daemon -------------------------------------------------------------
# Where transmission-daemon's RPC lives, and the basic-auth credentials the
# backend presents to it. These never reach the browser -- except in form mode,
# where they are also what the login page accepts.
TM_RPC_UPSTREAM=http://transmission:9091
TM_USER=transmission
TM_PASS=change-me
