# Copy to .env.local (gitignored). Leave unset to use the local compose daemon.
# TM_RPC_TARGET=http://your-server:9091
# TM_RPC_AUTH=user:pass

# Fake daemon instead of a container: `make sim`, or start it yourself with
# `node ui/sim/server.ts` and point the proxy at it. Knobs: TM_SIM_SEED, TM_SIM_COUNT,
# TM_SIM_SPEED (0 freezes the world, 30 finishes a download while you watch), TM_SIM_PORT.
# TM_RPC_TARGET=http://localhost:9092
