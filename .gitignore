# Node / frontend
# No trailing slash: also ignore a stray `node_modules` symlink/file, not just the
# directory (a tracked self-referential symlink once broke fresh `npm` installs).
node_modules
*.tsbuildinfo

# Coverage reports
/ui/coverage/

# Test output
ui/test-results/
ui/playwright-report/

# macOS
.DS_Store

# Editors / IDEs
.vscode/
.idea/
.zed/

# Local agent / browser tooling (machine-specific)
.claude/
.agents/
.codex/
.worktrees/
.superpowers/
.playwright-mcp/

# Local deliverables
docs/plans/

# Local data & secrets
.env
.env.*
!.env.example
*.db
*.db-*
data/
logs/

# Throwaway dev daemon state
scripts/backend.pid
scripts/backend.log
scripts/transmission-ui
scripts/state/
scripts/downloads/
scripts/watch/

# ship:begin (owned by ship init; the repo's own lines go above the begin marker)
# What the gate and the UI build write into the tree.
coverage/ui/
ui/node_modules/
ui/*.tsbuildinfo
# The UI build the Go binary embeds; .gitkeep stays tracked so go:embed's dir exists in a fresh clone.
backend/dist/*
!backend/dist/.gitkeep
# ship:end
