# Node / frontend
# No trailing slash: also ignore a stray `node_modules` symlink/file, not just the
# directory (a tracked self-referential symlink once broke fresh `npm` installs).
node_modules
ui/dist/
*.tsbuildinfo
# The Vite bundle make fe-build syncs in before `go build` embeds it. .gitkeep is
# tracked so go:embed has its dir in a fresh clone.
backend/dist/*
!backend/dist/.gitkeep

# Coverage reports
/coverage/
/ui/coverage/

# Test output
ui/test-results/
ui/playwright-report/

# macOS
.DS_Store

# Editors / IDEs
.vscode/
.idea/
.zed/

# Local agent / browser tooling (machine-specific)
.claude/
.agents/
.codex/
.worktrees/
.superpowers/
.playwright-mcp/

# Local deliverables
docs/plans/

# Local data & secrets
.env
.env.*
!.env.example
*.db
*.db-*
data/
logs/

# Throwaway dev daemon state
scripts/backend.pid
scripts/backend.log
scripts/transmission-ui
scripts/state/
scripts/downloads/
scripts/watch/
